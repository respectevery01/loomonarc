---
import Base from '../layouts/Base.astro';
---
<Base title="Bridge USDC to Arc" desc="Bridge USDC from Base to Arc in one page: connect wallet, pick an amount, sign once. Native USDC minted by Circle's CCTP v2. Flat 1% fee." path="bridge">
  <div class="wrap">

    <section class="hero">
      <p class="kicker">Base → Arc</p>
      <h1>Bridge to Arc.</h1>
      <p class="sub">
        Connect your wallet, pick an amount, sign twice. Native USDC arrives on Arc
        minted by Circle's official CCTP v2. Flat 1% fee, shown before you sign.
        Want zero fee and more steps? <a href="https://bridge.usdc.com" rel="noopener" target="_blank">Circle's official bridge</a> is always open.
      </p>
    </section>

    <section class="block" id="enter">
      <div class="panel" id="bridgePanel">
        <div class="wtop" id="wtop">
          <button class="chip wbtn" id="connectBtn">Connect wallet</button>
          <span class="netbadge" id="netBadge" hidden></span>
          <span class="bal" id="balLine" hidden></span>
        </div>

        <div id="widget" hidden>
          <div class="chips" id="chips">
            <button class="chip" data-usd="5">$5</button>
            <button class="chip is-on" data-usd="10">$10</button>
            <button class="chip" data-usd="25">$25</button>
            <button class="chip" data-usd="50">$50</button>
            <input id="customAmt" class="chip chip-input" type="number" inputmode="decimal" min="0.5" step="0.5" placeholder="Custom $" aria-label="Custom amount in USDC" />
          </div>

          <div class="route">
            <div class="route-line">
              <span class="dot from"></span>
              <div>
                <strong>You send</strong>
                <p id="sendLine">$10 USDC from your wallet</p>
              </div>
            </div>
            <div class="route-line">
              <span class="dot to"></span>
              <div>
                <strong>You receive on Arc</strong>
                <p id="recvLine">≈ $9.80 native USDC, minted by Circle</p>
              </div>
            </div>
            <div class="feegrid" id="feeGrid">
              <span>Loom fee (1%)</span><b id="loomFee">$0.10</b>
              <span>Circle network fee</span><b id="netFee">≤ $0.02</b>
            </div>
          </div>

          <div class="go">
            <button class="btn" id="actionBtn" disabled>Connect wallet</button>
            <p class="tiny" id="feeLine">
              One approval, one signature. Fee is taken inside the same transaction — funds never rest with Loom.
            </p>
          </div>
        </div>

        <div class="status" id="statusBox" hidden>
          <p class="mono" id="statusText"></p>
          <p class="tiny" id="statusLinks"></p>
        </div>

        <p class="tiny" id="noWallet" hidden>
          No EVM wallet detected. Install MetaMask, Rabby, OKX Wallet or Brave — or use the
          <a href="https://bridge.usdc.com" rel="noopener" target="_blank">official Circle bridge</a> directly.
        </p>
      </div>

      <div class="note">
        Transfers run on Circle's CCTP v2 Forwarding Service through our open-source
        <a href="/security/">router contract</a> — verified on Basescan, non-custodial:
        fee and burn execute in the same transaction you sign, nothing is pooled.
      </div>
    </section>
  </div>

  <script is:inline>
  (function () {
    var ARC_DOMAIN = 26;
    var CFG = {
      8453:    { name: 'Base',      domain: 6,  usdc: '0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913', messenger: '0x28b5a0e9C621a5BadaA536219b3a228C8168cf5d', router: '0x44e7d4146ef5e44ecfeeed81b114b08f62186ebf', live: false, iris: 'https://iris-api.circle.com', ex: 'https://basescan.org', arcex: '' },
      11155111:{ name: 'Sepolia',  domain: 0,  usdc: '0x1c7d4b196cb0c7b01d743fbc6116a902379c7238', messenger: '0x8fe6b999dc680ccfdd5bf7eb0974218be2542daa', router: '0xfd03027057da547b491e100e9dbf3b690fb206b7', iris: 'https://iris-api-sandbox.circle.com', ex: 'https://sepolia.etherscan.io', arcex: 'https://testnet.arcscan.app', test: true }
    };
    var st = { addr: null, chainId: null, cfg: null, bal: 0, allow: 0, amount: 10, netFeeHi: null, phase: 'idle', burnHash: null };

    var $ = function (id) { return document.getElementById(id); };
    var hexToNum = function (h) { return parseInt(h, 16); };
    var fmt = function (u6) { return (u6 / 1e6).toFixed(2); };

    function b32(addr) { return '0x000000000000000000000000' + addr.toLowerCase().slice(2); }
    var SEL = { approve: '095ea7b3', bridge: '9dc1017b' };
    function txData(sel, words) { return '0x' + sel + words; }
    function setStatus(text, links) {
      $('statusBox').hidden = false;
      $('statusText').textContent = text;
      $('statusLinks').innerHTML = links || '';
    }

    function W() { return window.__wallet || null; }

    function sleep(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }

    async function connected(w) {
      st.addr = addrOf(w); st.chainId = chainOf(w);
      if (!st.addr) return false;
      var badge = $('netBadge');
      var cid = st.chainId;
      if (CFG[cid]) {
        st.cfg = CFG[cid];
        badge.hidden = false;
        badge.textContent = st.cfg.name + (st.cfg.test ? ' · TESTNET' : '') + ' → Arc';
      } else {
        st.cfg = null; st.phase = 'switch';
        badge.hidden = false;
        badge.textContent = cid === 1 ? 'Ethereum gas will be brutal on launch day' : 'Wrong network';
        $('connectBtn').textContent = st.addr.slice(0, 6) + '…' + st.addr.slice(-4);
        $('widget').hidden = false;
        $('actionBtn').disabled = false;
        $('actionBtn').textContent = 'Switch to Base';
        return true;
      }
      $('connectBtn').textContent = st.addr.slice(0, 6) + '…' + st.addr.slice(-4);
      $('widget').hidden = false;
      await refresh();
      return true;
    }
    function addrOf(w) { try { return w ? (w.account() || (window.ethereum && window.ethereum.selectedAddress) || null) : (window.ethereum && window.ethereum.selectedAddress) || null; } catch (e) { return null; } }
    function chainOf(w) {
      try {
        if (w) { var c = w.chainId(); if (c) return c; }
        if (window.ethereum && window.ethereum.request) return parseInt(window.ethereum.request({ method: 'eth_chainId', params: [] }), 16);
      } catch (e) {}
      return null;
    }

    async function connect() {
      var w = W();
      if (!w && !window.ethereum) { $('noWallet').hidden = false; return; }
      if (w) {
        try { w.connect(); } catch (e) {}
        for (var i = 0; i < 240; i++) {   // wait up to 120s for a wallet to be picked
          await sleep(500);
          if (w.refreshProvider) w.refreshProvider();
          if (addrOf(w)) { if (await connected(w)) return; }
        }
        return;
      }
      try {
        await window.ethereum.request({ method: 'eth_requestAccounts', params: [] });
        if (window.ethereum && window.ethereum.request) { st.chainId = parseInt(await window.ethereum.request({ method: 'eth_chainId', params: [] }), 16); }
        await connected(null);
      } catch (e) { setStatus('Wallet connection failed: ' + (e.message || e), ''); }
    }

    async function rawReq(method, params) {
      var w = W();
      if (w && addrOf(w)) {
        if (method === 'eth_sendTransaction') return w.send(params[0]);
        if (method === 'eth_chainId') return '0x' + w.chainId().toString(16);
        return w.request(method, params);
      }
      if (window.ethereum && window.ethereum.request) return window.ethereum.request({ method: method, params: params });
      return Promise.reject(new Error('no provider'));
    }

    async function refresh() {
      var c = st.cfg;
      if (!c || !st.addr) return;
      var balData = txData('70a08231', st.addr.toLowerCase().slice(2).padStart(64, '0'));
      var allowData = txData('dd62ed3e', st.addr.toLowerCase().slice(2).padStart(64, '0') + c.router.slice(2).toLowerCase().padStart(64, '0'));
      try {
        var b = await rawReq('eth_call', [{ to: c.usdc, data: balData }, 'latest']);
        var a = await rawReq('eth_call', [{ to: c.usdc, data: allowData }, 'latest']);
        st.bal = Number(BigInt(b)); st.allow = Number(BigInt(a));
        $('balLine').hidden = false;
        $('balLine').textContent = 'Balance: $' + fmt(st.bal) + ' USDC' + (c.test ? ' (testnet)' : '');
      } catch (e) { }
      try {
        var r = await fetch(c.iris + '/v2/burn/USDC/fees/' + c.domain + '/' + ARC_DOMAIN + '?forward=true');
        var fees = await r.json();
        var f = fees.find(function (x) { return x.finalityThreshold === 1000; });
        if (f) { st.netFeeHi = Number(f.forwardFee.high) / 1e6; $('netFee').textContent = '≤ $' + st.netFeeHi.toFixed(3); }
      } catch (e) { }
      renderAmount(); renderAction();
    }

    function renderAmount() {
      var amt = st.amount;
      var fee = amt * 0.01;
      var arrive = amt - fee - (st.netFeeHi || 0.021);
      $('sendLine').textContent = '$' + amt.toFixed(2) + ' USDC from your wallet';
      $('recvLine').textContent = '≈ $' + Math.max(arrive, 0).toFixed(2) + ' native USDC, minted by Circle';
      $('loomFee').textContent = '$' + fee.toFixed(2);
    }

    function renderAction() {
      var btn = $('actionBtn');
      if (st.phase === 'switch') { btn.textContent = 'Switch to Base'; btn.disabled = false; return; }
      if (!st.cfg) { btn.textContent = 'Connect wallet'; btn.disabled = true; return; }
      if (st.cfg.router && st.cfg.live === false) { btn.textContent = 'Opens with Arc mainnet — September 16'; btn.disabled = true; return; }
      if (!st.cfg.router) { btn.textContent = 'Mainnet router goes live at launch'; btn.disabled = true; return; }
      if (st.amount < 0.5) { btn.textContent = 'Minimum $0.50'; btn.disabled = true; return; }
      if (st.bal < st.amount * 1e6) { btn.textContent = 'Not enough USDC' + (st.cfg.test ? ' (testnet)' : ''); btn.disabled = true; return; }
      if (st.allow < st.amount * 1e6) { btn.textContent = 'Step 1 — Approve USDC'; btn.disabled = false; st.phase = 'approve'; return; }
      btn.textContent = 'Step 2 — Bridge to Arc'; btn.disabled = false; st.phase = 'bridge';
    }

    async function doAction() {
      if (st.phase === 'switch') {
        try { await rawReq('wallet_switchEthereumChain', [{ chainId: '0x2105' }]); }
        catch (e) { setStatus('Could not switch network: ' + (e.message || e), ''); }
        return;
      }
      var c = st.cfg;
      if (!c || !c.router || c.live === false) return;
      var btn = $('actionBtn');
      btn.disabled = true;
      try {
        if (st.phase === 'approve') {
          btn.textContent = 'Waiting for approval…';
          var data = txData(SEL.approve, c.router.slice(2).toLowerCase().padStart(64, '0') + BigInt(Math.round(st.amount * 1e6)).toString(16).padStart(64, '0'));
          var h = await rawReq('eth_sendTransaction', [{ from: st.addr, to: c.usdc, data: data }]);
          setStatus('Approval sent — confirm in your wallet explorer:', '<a href="' + c.ex + '/tx/' + h + '" target="_blank" rel="noopener">' + h.slice(0, 18) + '…</a>');
          var rc = await waitTx(h);
          if (!rc || rc.status !== '0x1') { setStatus('Approval failed or timed out.', ''); btn.disabled = false; renderAction(); return; }
          await refresh(); return;
        }
        if (st.phase === 'bridge') {
          btn.textContent = 'Waiting for signature…';
          var total = BigInt(Math.round(st.amount * 1e6));
          var maxFee = BigInt(Math.ceil((st.netFeeHi || 0.021) * 1e6)) + 1000n;
          var words = total.toString(16).padStart(64, '0') + b32(st.addr).slice(2) + maxFee.toString(16).padStart(64, '0');
          var h2 = await rawReq('eth_sendTransaction', [{ from: st.addr, to: c.router, data: txData(SEL.bridge, words) }]);
          setStatus('Burn sent. Waiting for Circle to mint on Arc…', '<a href="' + c.ex + '/tx/' + h2 + '" target="_blank" rel="noopener">' + h2.slice(0, 18) + '…</a>');
          var rc2 = await waitTx(h2);
          if (!rc2 || rc2.status !== '0x1') { setStatus('Bridge transaction failed.', ''); btn.disabled = false; renderAction(); return; }
          var tries = 0;
          (function pollIris() {
            fetch(c.iris + '/v2/messages/' + c.domain + '?transactionHash=' + h2)
              .then(function (r) { return r.json(); })
              .then(function (m) {
                var fwd = m && m.messages && m.messages[0] && m.messages[0].forwardTxHash;
                if (fwd) {
                  var link = c.arcex ? '<a href="' + c.arcex + '/tx/' + fwd + '" target="_blank" rel="noopener">mint tx</a>' : 'mint tx ' + fwd.slice(0, 18) + '…';
                  setStatus('Done. Native USDC minted on Arc.', 'Burn: <a href="' + c.ex + '/tx/' + h2 + '" target="_blank" rel="noopener">' + h2.slice(0, 12) + '…</a> · ' + link);
                  btn.disabled = false; renderAction();
                } else if (++tries > 60) {
                  setStatus('Mint still pending — your burn is confirmed, Circle will mint shortly.', '');
                  btn.disabled = false; renderAction();
                } else { setTimeout(pollIris, 5000); }
              })
              .catch(function () { if (++tries > 60) { setStatus('Mint still pending — burn confirmed.', ''); btn.disabled = false; } else setTimeout(pollIris, 5000); });
          })();
        }
      } catch (e) {
        if (e && e.code === 4001) { setStatus('Rejected in wallet.', ''); }
        else { setStatus('Error: ' + ((e && e.message) || e), ''); }
        btn.disabled = false; renderAction();
      }
    }

    function waitTx(hash) {
      return new Promise(function (resolve) {
        var tries = 0;
        (function poll() {
          rawReq('eth_getTransactionReceipt', [hash]).then(function (rc) {
            if (rc) { resolve(rc); return; }
            if (++tries > 90) { resolve(null); return; }
            setTimeout(poll, 4000);
          }).catch(function () { if (++tries > 90) { resolve(null); } else setTimeout(poll, 4000); });
        })();
      });
    }

    var chips = document.querySelectorAll('#chips .chip');
    var custom = $('customAmt');
    chips.forEach(function (ch) {
      ch.addEventListener('click', function () {
        chips.forEach(function (x) { x.classList.remove('is-on'); });
        ch.classList.add('is-on');
        custom.value = '';
        st.amount = parseFloat(ch.getAttribute('data-usd'));
        renderAmount(); renderAction();
      });
    });
    custom.addEventListener('input', function () {
      chips.forEach(function (x) { x.classList.remove('is-on'); });
      var v = parseFloat(custom.value);
      if (!isNaN(v) && v > 0) { custom.classList.add('is-on'); st.amount = v; }
      else { custom.classList.remove('is-on'); st.amount = 0; }
      renderAmount(); renderAction();
    });
    $('connectBtn').addEventListener('click', connect);
    $('actionBtn').addEventListener('click', doAction);
  })();
  </script>

  <style is:global>
    .hero { padding: 72px 0 8px; }
    .hero .sub { font-size: 18px; color: var(--ink-2); max-width: 56ch; margin-top: 18px; }
    @media (max-width: 640px) { .hero { padding-top: 48px; } }
    .panel { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 22px; margin: 22px 0; }
    .wtop { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
    .netbadge { font-family: var(--mono); font-size: 12px; background: var(--accent-soft); color: var(--accent); padding: 4px 10px; border-radius: 999px; }
    .bal { font-size: 13px; color: var(--ink-2); }
    .chips { display: flex; gap: 10px; margin-bottom: 18px; flex-wrap: wrap; }
    .chip { border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 9px 18px; font-size: 15px; font-weight: 600; color: var(--ink); cursor: pointer; }
    .chip.is-on { background: var(--ink); color: var(--bg); border-color: var(--ink); }
    .chip-input { width: 110px; text-align: center; font-family: var(--mono); font-weight: 500; }
    .chip-input::-webkit-outer-spin-button, .chip-input::-webkit-inner-spin-button { -webkit-appearance: none; }
    .chip-input[type=number] { -moz-appearance: textfield; appearance: textfield; }
    .wbtn { font-size: 13px; padding: 7px 14px; }
    .route { margin-bottom: 6px; }
    .route-line { display: flex; gap: 12px; padding: 10px 0; }
    .dot { width: 9px; height: 9px; border-radius: 50%; margin-top: 7px; flex: none; }
    .dot.from { background: var(--ink-2); } .dot.to { background: var(--accent); }
    .route-line strong { font-size: 14px; }
    .route-line p { font-size: 14px; color: var(--ink-2); }
    .feegrid { display: grid; grid-template-columns: 1fr auto; gap: 4px 18px; font-size: 13px; color: var(--ink-2); border-top: 1px dashed var(--line); padding-top: 12px; margin-top: 6px; }
    .feegrid b { color: var(--ink); font-family: var(--mono); font-weight: 600; }
    .go { margin-top: 16px; }
    .go .btn { width: 100%; justify-content: center; }
    .tiny { font-size: 12.5px; color: var(--ink-2); margin-top: 10px; }
    .status { border-top: 1px solid var(--line); margin-top: 16px; padding-top: 14px; }
    .status .mono { font-family: var(--mono); font-size: 13px; color: var(--ink); }
    @media (max-width: 640px) { .panel { padding: 16px; } .chip { padding: 8px 14px; font-size: 14px; } }
  </style>

  <script>
    import { createAppKit } from '@reown/appkit';
    import { EthersAdapter } from '@reown/appkit-adapter-ethers';
    import { ethers } from 'ethers';

    const BASE = { id: 8453, chainNamespace: 'eip155', chainId: 8453, name: 'Base', rpcUrl: 'https://mainnet.base.org', currency: { name: 'Ether', symbol: 'ETH', decimals: 18 }, explorerUrl: 'https://basescan.org' };
    const SEPOLIA = { id: 11155111, chainNamespace: 'eip155', chainId: 11155111, name: 'Sepolia', rpcUrl: 'https://ethereum-sepolia-rpc.publicnode.com', currency: { name: 'Ether', symbol: 'ETH', decimals: 18 }, explorerUrl: 'https://sepolia.etherscan.io' };

    try {
      const adapter = new EthersAdapter({ ethers, networks: [BASE, SEPOLIA] });
      const appkit = createAppKit({
        adapters: [adapter],
        networks: [BASE, SEPOLIA],
        projectId: '04d0a3371d3a1e21bf8d2a31bd13b1a1',
        metadata: { name: 'Loom', description: 'Bridge USDC to Arc', url: 'https://loomonarc.xyz', icons: ['https://loomonarc.xyz/favicon.svg'] },
        themeMode: 'light',
        features: { analytics: false, email: false, socials: [] },
        allWallets: 'HIDE',
        excludedWalletIds: ['c57ca95b47569778a828d19178114f84db6ac205'],
      });
      let provider = null;
      window.__wallet = {
        connect() { appkit.open(); },
        refreshProvider() {
          try {
            const caip = appkit.getCaipAddress();
            if (caip) provider = appkit.getProvider(caip.split('/').slice(0, 2).join(':')) || provider;
          } catch (e) {}
        },
        account() { try { return appkit.getAddress() || null; } catch (e) { return null; } },
        chainId() { try { const a = appkit.getCaipAddress(); return a ? parseInt(a.split(':')[1], 10) : null; } catch (e) { return null; } },
        async request(method, params) {
          provider = provider || appkit.getProvider('eip155:8453');
          return provider.request({ method, params });
        },
        async send(tx) {
          provider = provider || appkit.getProvider('eip155:8453');
          return provider.request({ method: 'eth_sendTransaction', params: [tx] });
        },
      };
    } catch (e) {
      console.warn('AppKit init failed, falling back to injected wallet', e);
    }
  </script>
</Base>
